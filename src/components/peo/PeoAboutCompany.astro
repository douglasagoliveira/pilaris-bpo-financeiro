---
import { Play } from 'lucide-react';
import PeoButton from './PeoButton.astro';
import VideoModal from '../modals/VideoModal.astro';
---

<section class="py-20 lg:py-28 px-4 sm:px-8 bg-white">
  <div class="max-w-[1240px] mx-auto bg-[#F2F5F7] rounded-2xl lg:rounded-3xl p-6 sm:p-10 lg:p-14 overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      {/* Left Column: Image with Video Button Box */}
      <div class="lg:col-span-5 relative">
        <div class="rounded-2xl overflow-hidden shadow-md group relative">
          <img
            src="/images/ceo-pilaris-bpo-financeiro.jpg"
            alt="Consultoria e BPO Financeiro da Pilaris"
            class="w-full h-auto aspect-[4/3] sm:aspect-square object-cover transition-transform duration-700 group-hover:scale-105"
          />

          {/* Video Box Overlap at the bottom right */}
          <VideoModal
            triggerClass="absolute bottom-4 right-4 sm:bottom-6 sm:right-6 bg-white rounded-xl p-2.5 sm:p-3 shadow-xl flex items-center gap-3 cursor-pointer hover:bg-slate-50 transition-all group/btn border border-slate-100"
            eyebrow="Pilaris BPO Financeiro"
            heading="A base sólida para a sua gestão"
            iframeTitle="Apresentação Pilaris"
            videoUrl="https://www.youtube-nocookie.com/embed/BHACKCNDMW8?autoplay=1"
          >
            <div class="w-12 h-12 rounded-lg overflow-hidden relative flex-shrink-0">
              <img
                src="/images/ceo-pilaris-bpo-financeiro.jpg"
                alt=""
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-[#0F172A]/40 flex items-center justify-center">
                <div class="w-6 h-6 rounded-full bg-[#055ED3] text-white flex items-center justify-center pl-0.5 group-hover/btn:scale-110 transition-transform">
                  <Play className="w-3 h-3 fill-current" />
                </div>
              </div>
            </div>
            <div class="pr-2">
              <div class="text-[11px] font-mono uppercase text-slate-500 font-bold">Apresentação</div>
              <div class="text-xs font-bold text-[#0F172A]">Conheça a Pilaris</div>
            </div>
          </VideoModal>
        </div>
      </div>

      {/* Right Column: Copy & Stats */}
      <div class="lg:col-span-7 space-y-6 lg:space-y-8">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-mono font-normal uppercase tracking-wider text-[#3B82F6] mb-3">
            <img src="/brand/peo-star.svg" alt="" class="w-3.5 h-3.5" />
            <span>SOBRE A PILARIS</span>
          </div>

          <h2 class="text-2xl sm:text-4xl lg:text-[40px] font-semibold tracking-[-0.03em] text-[#0F172A] leading-[1.25]">
            Somos a equipe financeira que sua empresa precisa, sem o peso de contratar uma.

          </h2>
        </div>

        <div>
          <PeoButton label="Conheça a Pilaris" href="/conheca-a-pilaris" />
        </div>

        {/* 2 Counter Boxes side by side (Peo style) */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-slate-200/80">
          <div class="bg-white rounded-xl p-5 border border-slate-200/60 shadow-xs">
            <span class="text-xs font-bold font-mono uppercase text-slate-500 block mb-1">
              Atuação da Equipe
            </span>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] mb-1">
              5 dias
            </div>
            <p class="text-xs sm:text-sm text-[#3D4857] leading-relaxed">
              Equipe atuando de segunda a sexta-feira na operação do seu financeiro.
            </p>
          </div>

          <div class="bg-white rounded-xl p-5 border border-slate-200/60 shadow-xs">
            <span class="text-xs font-bold font-mono uppercase text-slate-500 block mb-1">
              Experiência
            </span>
            <div class="text-3xl sm:text-4xl font-extrabold text-[#0F172A] mb-1">
              + 18 
            </div>
            <p class="text-xs sm:text-sm text-[#3D4857] leading-relaxed">
              anos de experiência organizando e cuidando do financeiro de empresas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
