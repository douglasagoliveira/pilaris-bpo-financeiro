---
const words = ['Clareza', 'Controle', 'Previsibilidade', 'Confiança'];
---

<div class="py-4 bg-[#055ED3] text-white overflow-hidden relative border-y border-blue-400/20">
  <div class="animate-peo-marquee flex items-center whitespace-nowrap">
    {[...Array(6)].map(() => (
      <div class="flex items-center gap-10 sm:gap-14 px-6">
        {words.map((word) => (
          <div class="flex items-center gap-6 sm:gap-8">
            <img
              src="/brand/pattern-crescimento-pilaris-bpo.png"
              alt=""
              class="w-6 h-6 sm:w-8 sm:h-8 filter brightness-200"
            />
            <span class="text-2xl font-medium uppercase tracking-tight text-white select-none">
              {word}
            </span>
          </div>
        ))}
      </div>
    ))}
  </div>
</div>
