---
import type { AboutLink } from '../../data/about';
import PeoButton from '../peo/PeoButton.astro';
import { ArcMark } from './AboutParts';

interface Props {
  title: string;
  text: string;
  cta: AboutLink;
}

const { title, text, cta } = Astro.props;
---

<section class="about-closing relative overflow-hidden bg-[#055ED3] py-24 lg:py-32">
  {/* Brand arc: a discreet pattern on the right, one tone above the background */}
  <div class="pointer-events-none absolute inset-y-0 right-0 hidden md:flex items-center" aria-hidden="true">
    <div class="about-drift translate-x-[18%]">
      <ArcMark className="h-[560px] lg:h-[680px] w-auto text-[#FAFDFD]/10" />
    </div>
  </div>

  <div class="relative max-w-[1200px] mx-auto px-4 sm:px-6">
    <div class="max-w-[820px]">
      <h2
        data-reveal
        class="text-[40px] sm:text-6xl lg:text-[76px] font-semibold tracking-[-0.045em] leading-[1.02] text-[#FAFDFD]"
      >
        {title}
      </h2>

      <p
        data-reveal
        style="--reveal-order: 1"
        class="mt-7 max-w-[620px] text-lg sm:text-xl leading-relaxed text-[#FAFDFD]"
      >
        {text}
      </p>

      <div data-reveal style="--reveal-order: 2" class="mt-10">
        <PeoButton label={cta.label} href={cta.href} class="about-btn-on-blue" />
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/reveal';
</script>
