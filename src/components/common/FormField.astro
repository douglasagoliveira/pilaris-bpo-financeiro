---
/**
 * Label + control used by the contact forms. The page decides the grid; this component keeps
 * the control styling, names and autofill hints in one place.
 */
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'textarea';
  required?: boolean;
  placeholder?: string;
  autocomplete?: string;
  rows?: number;
  /** Vertical gap between the label text and the control. */
  gap?: 'space-y-1' | 'space-y-1.5';
}

const {
  label,
  name,
  type = 'text',
  required = false,
  placeholder,
  autocomplete,
  rows = 4,
  gap = 'space-y-1.5'
} = Astro.props;

const controlClass =
  'w-full px-4 py-3 rounded-xl bg-[#F2F5F7] border border-slate-200 focus:border-[#3B82F6] outline-none text-sm';
---

<label class:list={['block', gap, 'text-xs font-bold text-[#0F172A]']}>
  <span>{label}</span>
  {
    type === 'textarea' ? (
      <textarea
        name={name}
        rows={rows}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        class={controlClass}
      />
    ) : (
      <input
        type={type}
        name={name}
        required={required}
        placeholder={placeholder}
        autocomplete={autocomplete}
        class={controlClass}
      />
    )
  }
</label>
