---
import { Font } from 'astro:assets';
import '../styles/global.css';
import FloatingWhatsApp from '../components/common/FloatingWhatsApp.astro';
import Header from '../components/common/Header.astro';
import MobileMenu from '../components/common/MobileMenu.astro';
import SEO from '../components/common/SEO.astro';
import PeoFooter from '../components/peo/PeoFooter.astro';
import { site } from '../data/site';
import type { SEOProps } from '../lib/types';

interface Props extends SEOProps {
  /** `false` on pages that open with a light section: the header starts solid. */
  darkHero?: boolean;
}

const { title, description, darkHero = true, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F172A" />
    {/* `?v=` forces browsers to drop the cached all-black favicon of older builds; bump when the SVG changes. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />
    <Font cssVariable="--font-public-sans" preload />
    {/* The top ticker (first thing on screen) uses the medium weight */}
    <Font cssVariable="--font-dm-mono" preload={[{ weight: 500 }]} />
    <SEO title={title} description={description} {...seoProps} />
    <script is:inline>
      /* The header intro animation plays on the first page of a visit only. */
      try {
        if (sessionStorage.getItem('pilaris:visited')) {
          document.documentElement.classList.add('is-return-visit');
        } else {
          sessionStorage.setItem('pilaris:visited', '1');
        }
      } catch (error) {
        /* storage unavailable: keep the default behaviour */
      }
    </script>
  </head>
  <body class="bg-[#FFFFFF] text-[#3D4857] antialiased selection:bg-[#3B82F6] selection:text-white">
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <div class="min-h-screen flex flex-col bg-[#FFFFFF] text-[#3D4857] selection:bg-[#3B82F6] selection:text-white relative">
      {/* Fixed header: scroll progress, top ticker and navigation */}
      <Header darkHero={darkHero} />

      {/* Main Content Area */}
      <main id="main-content" class="flex-1 w-full">
        <slot />
      </main>

      <PeoFooter />

      {/* Floating WhatsApp Action */}
      <FloatingWhatsApp />

      {/* Menu of small screens (opened by the header button) */}
      <MobileMenu />
    </div>
  </body>
</html>
