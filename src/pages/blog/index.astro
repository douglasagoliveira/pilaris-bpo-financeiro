---
import { ArrowUpRight, Calendar, Clock, MessageSquare, Search, Tag } from 'lucide-react';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { blogPosts } from '../../data/blog';
import { site } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { blogSchema, breadcrumbSchema } from '../../lib/schema';

const title = `Blog | ${site.name}`;
const description =
  'Artigos práticos sobre BPO financeiro, gestão fiscal, projeções de fluxo de caixa e inteligência para tomadas de decisão.';

const orderedPosts = [...blogPosts].sort((a, b) => b.date.localeCompare(a.date));
const featured = orderedPosts[0];
const posts = orderedPosts.slice(1);
const recentPosts = orderedPosts.slice(0, 3);

const categories = [...new Set(orderedPosts.map((post) => post.category))];

const categoryCount = (category: string) =>
  orderedPosts.filter((post) => post.category === category).length;

const MONTHS = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];

const formatDate = (iso: string) => {
  const [year, month, day] = iso.split('-');
  return `${day} ${MONTHS[Number(month) - 1]} ${year}`;
};

const schemas = [
  breadcrumbSchema([
    { name: 'Pilaris', url: site.url },
    { name: 'Blog', url: `${site.url}/blog` }
  ]),
  blogSchema(blogPosts)
];
---

<BaseLayout title={title} description={description} schemas={schemas}>
  <div class="animate-fadeIn">
    <section class="pt-[132px] pb-16 sm:pb-20 bg-[#021A39] text-white relative overflow-hidden">
      <img
        src="/brand/pattern-waves.svg"
        alt=""
        aria-hidden="true"
        class="absolute -right-24 -top-24 w-[48vw] max-w-[620px] opacity-10 pointer-events-none"
      />

      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 relative z-10">
        <Breadcrumb current="Blog" class="flex items-center gap-2 text-xs font-mono text-[#99B7FC] mb-6 uppercase" />

        <div class="mt-6 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-end">
          <div class="lg:col-span-8 space-y-5">
            <div class="inline-flex items-center gap-2 text-[11px] font-mono-code uppercase tracking-[0.18em] text-[#99B7FC]">
              <img src="/brand/peo-star.svg" alt="" class="w-3.5 h-3.5" />
              <span>Conteúdo Pilaris</span>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-medium tracking-[-0.04em] leading-[1.04] text-white max-w-3xl">
              Conteúdos e inteligência para uma gestão financeira mais clara.
            </h1>

            <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
              Artigos práticos sobre BPO financeiro, gestão fiscal, projeções de fluxo de caixa e inteligência para tomadas de decisão.
            </p>
          </div>

          <div class="lg:col-span-4">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm">
              <div class="flex items-baseline gap-3">
                <span class="text-3xl font-medium font-mono-code text-white">
                  {String(blogPosts.length).padStart(2, '0')}
                </span>
                <span class="text-xs text-slate-300">artigos publicados</span>
              </div>
              <div class="mt-4 h-px bg-white/10"></div>
              <p class="mt-4 text-xs text-slate-400 leading-relaxed">
                Conteúdo produzido pelo time Pilaris para apoiar a rotina financeira da sua empresa.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 sm:py-20 lg:py-24 bg-[#FAFDFD]">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
          <div class="lg:col-span-8">
            <div data-blog-featured>
              <div class="flex items-center gap-3 mb-5">
                <span class="h-px w-8 bg-[#055ED3]"></span>
                <span class="text-[11px] font-mono-code uppercase tracking-[0.18em] text-[#055ED3]">Em destaque</span>
              </div>

              <article
                data-blog-card
                data-category={featured.category}
                data-search={`${featured.title} ${featured.description} ${featured.category}`}
                class="group"
              >
              <a
                href={`/blog/${featured.slug}`}
                class="block overflow-hidden rounded-[32px] border border-[#021A39]/10 bg-white transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-[#055ED3]/30 hover:shadow-[0_28px_60px_-30px_rgba(2,26,57,0.3)]"
              >
                <div class="grid md:grid-cols-2">
                  <div class="relative aspect-[3/2] md:aspect-auto md:min-h-[360px] overflow-hidden bg-[#E9EBFF]">
                    <img
                      src={featured.image}
                      alt={featured.title}
                      loading="eager"
                      decoding="async"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
                    />
                    <span class="absolute left-5 top-5 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-[10px] font-mono-code uppercase tracking-wider text-[#055ED3] backdrop-blur-sm">
                      <Tag className="w-3 h-3" />
                      {featured.category}
                    </span>
                  </div>

                  <div class="flex flex-col justify-between p-7 sm:p-9">
                    <div>
                      <div class="flex flex-wrap items-center gap-3 text-[11px] font-mono-code uppercase tracking-wider text-slate-500">
                        <time datetime={featured.date}>{formatDate(featured.date)}</time>
                        <span class="w-1 h-1 rounded-full bg-[#99B7FC]"></span>
                        <span>{featured.readTime}</span>
                      </div>

                      <h2 class="mt-4 text-2xl sm:text-3xl lg:text-[34px] font-medium tracking-[-0.03em] leading-[1.15] text-[#021A39] transition-colors group-hover:text-[#055ED3]">
                        {featured.title}
                      </h2>

                      <p class="mt-4 text-sm sm:text-base leading-relaxed text-[#3D4857]">
                        {featured.description}
                      </p>
                    </div>

                    <div class="mt-8 pt-5 border-t border-[#021A39]/10 flex items-center justify-between gap-4">
                      <span class="text-[10px] font-mono-code uppercase tracking-[0.16em] text-[#055ED3]">
                        Matéria em destaque
                      </span>

                      <span class="inline-flex items-center gap-2 text-sm font-medium text-[#021A39] transition-colors group-hover:text-[#055ED3]">
                        <span>Ler artigo</span>
                        <span class="w-8 h-8 rounded-full bg-[#E9EBFF] flex items-center justify-center text-[#055ED3] transition-colors group-hover:bg-[#055ED3] group-hover:text-white">
                          <ArrowUpRight className="w-4 h-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                        </span>
                      </span>
                    </div>
                  </div>
                </div>
              </a>
            </article>
            </div>

            <div class="mt-12 pt-6 border-t border-[#021A39]/10 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filtrar artigos por categoria">
                <button
                  type="button"
                  data-blog-filter="todos"
                  aria-pressed="true"
                  class="rounded-full border border-[#021A39]/15 px-4 py-2 text-[11px] font-mono-code uppercase tracking-wider text-slate-600 transition-all duration-300 cursor-pointer hover:border-[#055ED3]/40 hover:text-[#055ED3] aria-pressed:border-[#055ED3] aria-pressed:bg-[#055ED3] aria-pressed:text-white"
                >
                  Todos os artigos
                </button>

                {categories.map((category) => (
                  <button
                    type="button"
                    data-blog-filter={category}
                    aria-pressed="false"
                    class="rounded-full border border-[#021A39]/15 px-4 py-2 text-[11px] font-mono-code uppercase tracking-wider text-slate-600 transition-all duration-300 cursor-pointer hover:border-[#055ED3]/40 hover:text-[#055ED3] aria-pressed:border-[#055ED3] aria-pressed:bg-[#055ED3] aria-pressed:text-white"
                  >
                    {category}
                  </button>
                ))}
              </div>

              <span data-blog-count aria-live="polite" class="text-[11px] font-mono-code uppercase tracking-wider text-slate-500">
                {blogPosts.length} artigos
              </span>
            </div>

            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
              {posts.map((post) => (
                <article
                  data-blog-card
                  data-category={post.category}
                  data-search={`${post.title} ${post.description} ${post.category}`}
                  class="group"
                >
                  <a
                    href={`/blog/${post.slug}`}
                    class="flex h-full flex-col overflow-hidden rounded-[28px] border border-[#021A39]/10 bg-white transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:border-[#055ED3]/30 hover:shadow-[0_28px_60px_-30px_rgba(2,26,57,0.3)]"
                  >
                    <div class="relative aspect-[3/2] overflow-hidden bg-[#E9EBFF]">
                      <img
                        src={post.image}
                        alt={post.title}
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                      />
                      <span class="absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-white/95 px-3 py-1.5 text-[10px] font-mono-code uppercase tracking-wider text-[#055ED3] backdrop-blur-sm">
                        <Tag className="w-3 h-3" />
                        {post.category}
                      </span>
                    </div>

                    <div class="flex flex-1 flex-col p-6">
                      <div class="flex items-center gap-2 text-[11px] font-mono-code uppercase tracking-wider text-slate-500">
                        <Calendar className="w-3.5 h-3.5 text-[#055ED3]" />
                        <time datetime={post.date}>{formatDate(post.date)}</time>
                      </div>

                      <h3 class="mt-3 text-xl font-medium tracking-[-0.02em] leading-snug text-[#021A39] transition-colors group-hover:text-[#055ED3] line-clamp-2">
                        {post.title}
                      </h3>

                      <p class="mt-3 text-sm leading-relaxed text-slate-600 line-clamp-3">
                        {post.description}
                      </p>

                      <div class="mt-auto pt-5 flex items-center justify-between text-[11px] font-mono-code text-slate-500">
                        <span>{post.readTime}</span>
                        <span class="inline-flex items-center gap-1.5 font-medium text-[#021A39] transition-colors group-hover:text-[#055ED3]">
                          <span>Ler artigo</span>
                          <ArrowUpRight className="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                        </span>
                      </div>
                    </div>
                  </a>
                </article>
              ))}
            </div>

            <div data-blog-empty hidden class="mt-8 rounded-[24px] border border-dashed border-[#021A39]/20 bg-white p-10 text-center">
              <Search className="w-6 h-6 text-[#99B7FC] mx-auto" />
              <p class="mt-3 text-sm text-slate-600">
                Nenhum artigo encontrado. Selecione outra categoria ou ajuste a busca.
              </p>
            </div>
          </div>

          <aside class="lg:col-span-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-6" aria-label="Navegação do blog">
            <div class="rounded-[24px] border border-[#021A39]/10 bg-white p-6">
              <div class="flex items-center gap-2 mb-4">
                <Search className="w-4 h-4 text-[#055ED3]" />
                <h2 class="text-base font-medium text-[#021A39]">Buscar artigos</h2>
              </div>

              <form role="search" data-blog-search-form>
                <label for="blog-search" class="sr-only">Buscar artigos</label>
                <input
                  id="blog-search"
                  data-blog-search
                  type="search"
                  placeholder="Buscar por título ou tema..."
                  class="w-full rounded-full border border-[#021A39]/15 bg-[#FAFDFD] px-4 py-3 text-sm text-[#021A39] placeholder:text-slate-400 outline-none transition-all focus:border-[#055ED3] focus:ring-2 focus:ring-[#055ED3]/15"
                />
              </form>
            </div>

            <div class="rounded-[24px] border border-[#021A39]/10 bg-white p-6">
              <div class="flex items-center gap-2 mb-4">
                <Tag className="w-4 h-4 text-[#055ED3]" />
                <h2 class="text-base font-medium text-[#021A39]">Categorias</h2>
              </div>

              <ul class="space-y-1">
                <li>
                  <button
                    type="button"
                    data-blog-filter="todos"
                    aria-pressed="true"
                    class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-slate-600 transition-colors cursor-pointer hover:bg-[#E9EBFF]/60 hover:text-[#021A39] aria-pressed:bg-[#E9EBFF] aria-pressed:text-[#021A39]"
                  >
                    <span>Todos os artigos</span>
                    <span class="text-[11px] font-mono-code text-slate-400">{blogPosts.length}</span>
                  </button>
                </li>

                {categories.map((category) => (
                  <li>
                    <button
                      type="button"
                      data-blog-filter={category}
                      aria-pressed="false"
                      class="flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-left text-sm text-slate-600 transition-colors cursor-pointer hover:bg-[#E9EBFF]/60 hover:text-[#021A39] aria-pressed:bg-[#E9EBFF] aria-pressed:text-[#021A39]"
                    >
                      <span>{category}</span>
                      <span class="text-[11px] font-mono-code text-slate-400">{categoryCount(category)}</span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>

            <div class="rounded-[24px] border border-[#021A39]/10 bg-white p-6">
              <div class="flex items-center gap-2 mb-4">
                <Clock className="w-4 h-4 text-[#055ED3]" />
                <h2 class="text-base font-medium text-[#021A39]">Publicações recentes</h2>
              </div>

              <ul class="space-y-4">
                {recentPosts.map((post) => (
                  <li>
                    <a href={`/blog/${post.slug}`} class="group flex items-center gap-3">
                      <div class="h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-[#E9EBFF]">
                        <img
                          src={post.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                      </div>

                      <div class="min-w-0">
                        <time datetime={post.date} class="block text-[10px] font-mono-code uppercase tracking-wider text-[#055ED3]">
                          {formatDate(post.date)}
                        </time>
                        <h3 class="mt-1 text-sm font-medium leading-snug text-[#021A39] transition-colors group-hover:text-[#055ED3] line-clamp-2">
                          {post.title}
                        </h3>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            <div class="relative overflow-hidden rounded-[24px] bg-[#021A39] p-6 text-white">
              <img
                src="/brand/pattern-waves.svg"
                alt=""
                aria-hidden="true"
                class="absolute -right-10 -bottom-10 w-44 opacity-10 pointer-events-none"
              />

              <div class="relative">
                <span class="text-[10px] font-mono-code uppercase tracking-[0.18em] text-[#99B7FC]">
                  Assessoria Pilaris
                </span>

                <h2 class="mt-2 text-xl font-medium tracking-[-0.02em] leading-snug text-white">
                  Financeiro organizado começa com uma boa conversa.
                </h2>

                <p class="mt-2 text-xs leading-relaxed text-slate-300">
                  Fale com nosso time e entenda como estruturar a rotina financeira da sua empresa.
                </p>

                <a
                  href={site.whatsapp}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 flex w-full items-center justify-center gap-2 rounded-full bg-[#055ED3] px-4 py-3 text-xs font-medium text-white transition-colors hover:bg-white hover:text-[#021A39]"
                >
                  <MessageSquare className="w-4 h-4" />
                  <span>Falar no WhatsApp</span>
                </a>
              </div>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-blog-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-blog-card]');
  const searchForm = document.querySelector<HTMLFormElement>('[data-blog-search-form]');
  const searchInput = document.querySelector<HTMLInputElement>('[data-blog-search]');
  const count = document.querySelector<HTMLElement>('[data-blog-count]');
  const empty = document.querySelector<HTMLElement>('[data-blog-empty]');
  const featuredWrap = document.querySelector<HTMLElement>('[data-blog-featured]');
  const featuredCard = featuredWrap?.querySelector<HTMLElement>('[data-blog-card]');

  let activeCategory = 'todos';
  let query = '';

  const normalize = (value: string) =>
    value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  const applyFilters = () => {
    const term = normalize(query.trim());
    let visible = 0;

    cards.forEach((card) => {
      const matchesCategory =
        activeCategory === 'todos' || card.dataset.category === activeCategory;
      const matchesQuery =
        !term || normalize(card.dataset.search ?? '').includes(term);
      const show = matchesCategory && matchesQuery;

      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });

    if (count) {
      count.textContent = `${visible} ${visible === 1 ? 'artigo' : 'artigos'}`;
    }

    if (featuredWrap && featuredCard) {
      featuredWrap.classList.toggle('hidden', featuredCard.classList.contains('hidden'));
    }

    if (empty) {
      empty.hidden = visible !== 0;
    }
  };

  filters.forEach((filter) => {
    filter.addEventListener('click', () => {
      activeCategory = filter.dataset.blogFilter ?? 'todos';
      filters.forEach((item) =>
        item.setAttribute('aria-pressed', String(item === filter))
      );
      applyFilters();
    });
  });

  searchForm?.addEventListener('submit', (event) => event.preventDefault());

  searchInput?.addEventListener('input', () => {
    query = searchInput.value;
    applyFilters();
  });
</script>